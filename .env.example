LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# optional knobs (defaults shown)
# LLM_ENABLED=true     # false = kill switch: no model call, deterministic fallback answer
# LLM_STUB=0           # 1 = hard-coded schema-valid answer, no model call
# LLM_TIMEOUT=30       # seconds per attempt
# LLM_MAX_RETRIES=3    # retries on timeout/429/5xx only
